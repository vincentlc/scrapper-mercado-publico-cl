# Google Sheets Configuration
GOOGLE_SHEETS_ID=your_spreadsheet_id_here
GOOGLE_SERVICE_ACCOUNT_JSON=your_base64_encoded_json_here

# Mailgun Configuration (for email alerts)
MAILGUN_API_KEY=your_mailgun_api_key
MAILGUN_DOMAIN=your_mailgun_domain

# Optional: Mercado Público Feed URL (solo para descarga CSV local)
# MERCADO_PUBLICO_FEED_URL=https://www.mercadopublico.cl/Portal/att.ashx?id=5

# Ticket API oficial (requerido para GitHub Actions; opcional en local)
# Solicitar en https://api.mercadopublico.cl/modules/Participa.aspx
# MERCADO_PUBLICO_API_TICKET=your-uuid-ticket-here
# MERCADO_PUBLICO_API_ENRICH=1          # 0 = insertar solo datos del listado (rápido)
# MERCADO_PUBLICO_API_ENRICH_WORKERS=8 # paralelismo al pedir detalle por código

# Database (for local development, not used in serverless)
DATABASE_URL=sqlite:///data/licitaciones.db

# Local dev quick start:
#   cp .env.example .env
#   # optional: MERCADO_PUBLICO_API_TICKET=...  (to test API source locally)
#   ./run_all.sh scrape --source api --local-only
#   ./run_all.sh server
